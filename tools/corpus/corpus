def find_manifest(root, explicit=None):
    if explicit:
        return explicit
    for name in ("corpus.toml", "manifest.toml"):
        path = os.path.join(root, name)
        if os.path.isfile(path):
            return path
    return os.path.join(root, "corpus.toml")


def load_manifest(root, explicit=None):
    path = find_manifest(root, explicit)
    if not os.path.isfile(path):
        return None, ["manifest file not found: %s" % path]
    try:
        with open(path, "rb") as fh:
            data = tomllib.load(fh)
    except Exception as exc:
        return None, ["manifest file does not parse: %s: %s" % (path, exc)]
    return data, []


def manifest_mode(data):
    if isinstance(data.get("corpus"), dict):
        mode = data["corpus"].get("mode", "public")
    else:
        mode = "public"
    return mode


def spdx_ids(expr):
    ids = set(DOCREF_RE.findall(expr))
    cleaned = DOCREF_RE.sub(" ", expr)
    cleaned = re.sub(r"\bWITH\s+[A-Za-z0-9.+-]+", " ", cleaned)
    for token in SPDX_ID_RE.findall(cleaned):
        if token in ("OR", "AND", "WITH"):
            continue
        ids.add(token)
    return ids

def _spdx_tokenize(expr):
    tokens = []
    pos = 0
    while pos < len(expr):
        char = expr[pos]
        if char.isspace():
            pos += 1
        elif char == "(" or char == ")":
            tokens.append(char)
            pos += 1
        else:
            match = DOCREF_RE.match(expr, pos)
            if match is None:
                match = SPDX_ID_RE.match(expr, pos)
            if match is None:
                return None
            tokens.append(match.group(0))
            pos = match.end()
    return tokens


def _spdx_parse(tokens):
    pos = 0

    def parse_or():
        nonlocal pos
        left = parse_and()
        if left is None:
            return None
        while pos < len(tokens) and tokens[pos] == "OR":
            pos += 1
            right = parse_and()
            if right is None:
                return None
            left = (left[0] + right[0], left[1] or right[1], left[2] or right[2])
        return left

    def parse_and():
        nonlocal pos
        left = parse_unary()
        if left is None:
            return None
        while pos < len(tokens) and tokens[pos] == "AND":
            pos += 1
            right = parse_unary()
            if right is None:
                return None
            left = (left[0] + right[0], True, left[2] or right[2])
        return left

    def parse_unary():
        nonlocal pos
        if pos < len(tokens) and tokens[pos] == "(":
            pos += 1
            node = parse_or()
            if node is None or pos >= len(tokens) or tokens[pos] != ")":
                return None
            pos += 1
            return node
        if pos < len(tokens) and tokens[pos] not in ("OR", "AND", "WITH", "(", ")"):
            name = tokens[pos]
            pos += 1
            if pos + 1 < len(tokens) and tokens[pos] == "WITH":
                pos += 1
                if (tokens[pos] in ("OR", "AND", "WITH", "(", ")")
                        or ":" in tokens[pos]
                        or tokens[pos].startswith(("LicenseRef-", "DocumentRef-"))):
                    return None
                pos += 1
                return ([name], False, True)
            return ([name], False, False)
        return None

    node = parse_or()
    if node is None or pos != len(tokens):
        return None
    return node


def _spdx_public_ok(expr):
    parsed = _spdx_parse(_spdx_tokenize(expr) or [])
    if parsed is None:
        return False
    ids, has_and, has_with = parsed
    if has_and or has_with or not ids:
        return False
    return all(item in PUBLIC_ALLOWLIST for item in ids)


def _spdx_wellformed(expr):
    return _spdx_parse(_spdx_tokenize(expr) or []) is not None


def public_spdx_ok(expr):
    return _spdx_public_ok(expr)


def extension_ok(language, relpath):
    exts = EXTENSIONS.get(language, [])
    base = os.path.basename(relpath)
    if base in STARLARK_SPECIAL and language == "starlark":
        return True
    for ext in exts:
        if relpath.endswith(ext):
            return True
    return False


def list_project_files(projdir):
    found = []
    for dirpath, dirnames, filenames in os.walk(projdir, followlinks=False):
        dirnames.sort()
        for name in sorted(dirnames):
            full = os.path.join(dirpath, name)
            if os.path.islink(full):
                rel = os.path.relpath(full, projdir).replace(os.sep, "/")
                found.append((rel, full))
        for name in sorted(filenames):
            full = os.path.join(dirpath, name)
            rel = os.path.relpath(full, projdir).replace(os.sep, "/")
            found.append((rel, full))
    return found


def compute_tree_hash(projdir):
    digest = hashlib.sha256()
    for rel, full in list_project_files(projdir):
        if os.path.islink(full) or not os.path.isfile(full):
            continue
        with open(full, "rb") as fh:
            content = fh.read()
        digest.update(rel.encode("utf-8"))
        digest.update(b"\0")
        digest.update(content)
        digest.update(b"\0")
    return "sha256:" + digest.hexdigest()


def find_askalono(explicit=None):
    for candidate in (explicit, os.environ.get("CORPUS_ASKALONO")):
        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return shutil.which("askalono")


def detect_with_askalono(path, binary):
    try:
        proc = subprocess.run([binary, "id", path], capture_output=True,
                              text=True, timeout=120)
    except Exception as exc:
        return None, 0.0, "askalono error: %s" % exc
    license_id = None
    score = 0.0
    for line in proc.stdout.splitlines():
        if line.startswith("License:"):
            license_id = line.split(":", 1)[1].strip()
            license_id = re.sub(r"\s*\(original text\)\s*$", "", license_id).strip()
        elif line.startswith("Score:"):
            try:
                score = float(line.split(":", 1)[1].strip())
            except ValueError:
                score = 0.0
    if license_id is None:
        detail = (proc.stdout + proc.stderr).strip().splitlines()
        return None, 0.0, detail[0] if detail else "askalono reported no license"
    return license_id, score, ""


def detect_license_file(path, backend=None):
    selected = backend or os.environ.get("CORPUS_LICENSE_DETECTOR", "askalono")
    if selected != "askalono":
        return None, 0.0, "unknown license detector backend: %s" % selected
    binary = find_askalono()
    if binary is None:
        return None, 0.0, ("license detector askalono not found "
                            "(PATH or CORPUS_ASKALONO); refusing")
    return detect_with_askalono(path, binary)


def header_spdx_ids(text):
    ids = set()
    for match in SPDX_HEADER_RE.finditer(text):
        ids |= spdx_ids(match.group(1))
    return ids


def has_copyleft_phrase(text):
    lowered = text.lower()
    return any(phrase in lowered for phrase in COPYLEFT_PHRASES)

def non_allowlist_header_license(text):
    scrubbed = re.sub(r"//|--|#|;|%|\*|\(\*|\*\)|<!--|-->|\|#|<#|#>", " ", text)
    folded = re.sub(r"\s+", " ", scrubbed).lower()
    for phrase, label in NON_ALLOWLIST_HEADER_PHRASES:
        if phrase in folded:
            return label
    return None



GENERATED_CODE_GENERATED_RE = re.compile(r"Code generated .*DO NOT EDIT")
GENERATED_HEAD_LINES = 10


def looks_generated(content):
    try:
        text = content.decode("utf-8", "replace")
    except Exception:
        return False
    if GENERATED_CODE_GENERATED_RE.search(text):
        return True
    for line in text.splitlines()[:GENERATED_HEAD_LINES]:
        if "AUTOGENERATED" in line:
            return True
    return False


def scan_secrets(content):
    hits = []
    for name, pattern in SECRET_PATTERNS:
        if pattern.search(content):
            hits.append(name)
    return hits


def check_license_files(projdir, declared_ids, public, errors, tag):
    candidates = []
    for rel, full in list_project_files(projdir):
        depth = rel.count("/")
        base = os.path.basename(rel)
        if depth == 0 and base in LICENSE_NAMES:
            if os.path.islink(full) or not os.path.isfile(full):
                continue
            candidates.append(full)
    if not candidates:
        errors.append("%s: copied entry has no LICENSE or COPYING file" % tag)
        return
    best = None
    detail = ""
    missing_detector = False
    for path in candidates:
        license_id, score, note = detect_license_file(path)
        if note.startswith("license detector askalono not found"):
            missing_detector = True
            detail = note
            break
        if license_id is None:
            errors.append("%s: license file %s unidentified (score below %.2f or no match)" %
                          (tag, os.path.basename(path), ASKALONO_THRESHOLD))
            continue
        if score < ASKALONO_THRESHOLD:
            errors.append("%s: license file %s identified as %s with score %.3f below %.2f" %
                          (tag, os.path.basename(path), license_id, score, ASKALONO_THRESHOLD))
            continue
        if license_id not in declared_ids:
            errors.append("%s: license file says %s which is not in declared spdx" %
                          (tag, license_id))
            continue
        if public and license_id not in PUBLIC_ALLOWLIST:
            errors.append("%s: license file says %s which is not on the public allowlist" %
                          (tag, license_id))
            continue
        best = license_id
    if missing_detector:
        errors.append("%s: %s" % (tag, detail))
    elif best is None and not [e for e in errors if e.startswith(tag + ": license file")]:
        errors.append("%s: no license file passed detection" % tag)


def check_headers(projdir, language, declared_ids, public, errors, tag):
    for rel, full in list_project_files(projdir):
        if not extension_ok(language, rel):
            continue
        if os.path.islink(full) or not os.path.isfile(full):
            continue
        try:
            with open(full, "rb") as fh:
                raw = fh.read(65536)
        except OSError as exc:
            errors.append("%s: cannot read %s: %s" % (tag, rel, exc))
            continue
        text = raw.decode("utf-8", errors="replace")
        ids = header_spdx_ids(text)
        if public:
            bad_expr = next((match.group(1) for match in SPDX_HEADER_RE.finditer(text)
                             if not _spdx_public_ok(match.group(1))), None)
            if bad_expr is not None:
                errors.append("%s: %s header expression %r is outside the public allowlist "
                              "(MIT, Apache-2.0, OR only)" % (tag, rel, bad_expr))
            elif has_copyleft_phrase(text):
                errors.append("%s: %s header carries copyleft license text" % (tag, rel))
            elif not ids and non_allowlist_header_license(text) is not None:
                errors.append("%s: %s header carries %s license text outside the public "
                              "allowlist (MIT, Apache-2.0, OR only)" %
                              (tag, rel, non_allowlist_header_license(text)))
            else:
                bad = {i for i in ids if i not in declared_ids}
                if bad:
                    errors.append("%s: %s header names %s outside declared spdx" %
                                  (tag, rel, sorted(bad)[0]))
                    continue
        else:
            bad = {i for i in ids if i not in declared_ids}
            if bad:
                errors.append("%s: %s header names %s outside declared spdx" %
                              (tag, rel, sorted(bad)[0]))
                continue
            if has_copyleft_phrase(text) and not (declared_ids & COPYLEFT_IDS):
                errors.append("%s: %s carries copyleft license text outside declared spdx" %
                              (tag, rel))


def check_project_files(projdir, language, errors, tag):
    total = 0
    for rel, full in list_project_files(projdir):
        if os.path.islink(full):
            errors.append("%s: %s is a symlink; copies must be plain files" % (tag, rel))
            continue
        if not os.path.isfile(full):
            continue
        if os.path.basename(rel) == ".gitmodules" or rel.endswith("/.gitmodules"):
            errors.append("%s: submodules are excluded; %s must not be copied" % (tag, rel))
        size = os.path.getsize(full)
        total += size
        if size > MAX_FILE_BYTES:
            errors.append("%s: %s is %d bytes, above the %d per-file cap" %
                          (tag, rel, size, MAX_FILE_BYTES))
        base = os.path.basename(rel)
        top_level_doc = rel.count("/") == 0 and base in (
            "UPSTREAM.md",) + LICENSE_NAMES + NOTICE_NAMES
        if not extension_ok(language, rel) and not top_level_doc:
            errors.append("%s: %s extension is not allowlisted for %s" % (tag, rel, language))
            continue
        try:
            with open(full, "rb") as fh:
                content = fh.read()
        except OSError as exc:
            errors.append("%s: cannot read %s: %s" % (tag, rel, exc))
            continue
        if b"\0" in content[:8192]:
            errors.append("%s: %s looks binary; binaries are excluded" % (tag, rel))
        for name in scan_secrets(content):
            errors.append("%s: %s matches secret pattern %s" % (tag, rel, name))
        if extension_ok(language, rel) and looks_generated(content):
            errors.append("%s: %s looks generated; generated files are excluded" %
                          (tag, rel))
    return total


def check_nested_licenses(projdir, errors, tag):
    top = {}
    for rel, full in list_project_files(projdir):
        base = os.path.basename(rel)
        if rel.count("/") == 0 and base in LICENSE_NAMES + NOTICE_NAMES:
            if os.path.islink(full) or not os.path.isfile(full):
                continue
            with open(full, "rb") as fh:
                top[base] = fh.read()
    for rel, full in list_project_files(projdir):
        base = os.path.basename(rel)
        if rel.count("/") > 0 and base in LICENSE_NAMES + NOTICE_NAMES:
            if os.path.islink(full) or not os.path.isfile(full):
                continue
            with open(full, "rb") as fh:
                content = fh.read()
            if content not in set(top.values()):
                errors.append("%s: nested %s differs from the project license; "
                              "vendored third-party code is excluded" % (tag, rel))


def verify_project(root, project, mode, errors):
    name = project.get("name", "?")
    tag = "project %s" % name
    language = project.get("language", "")
    if not isinstance(name, str) or not NAME_RE.match(name):
        errors.append("%s: bad name; use [a-z0-9-]" % tag)
        return 0
    if language not in EXTENSIONS:
        errors.append("%s: unknown language %r" % (tag, language))
        return 0
    url = project.get("url", "")
    rev = project.get("rev", "")
    spdx = project.get("spdx", "")
    storage = project.get("storage", "")
    if not isinstance(url, str) or not (url.startswith("https://") or url.startswith("file://")):
        errors.append("%s: url must start with https:// or file://" % tag)
    if not isinstance(rev, str) or not REV_RE.match(rev):
        errors.append("%s: rev must be a 40-hex commit, never a branch or tag" % tag)
    if not isinstance(spdx, str) or not spdx_ids(spdx):
        errors.append("%s: spdx must name at least one SPDX id" % tag)
    elif not _spdx_wellformed(spdx):
        errors.append("%s: spdx %r is not a well-formed expression" % (tag, spdx))
    if storage not in ("copied", "pinned"):
        errors.append("%s: storage must be copied or pinned" % tag)
        return 0
    if not isinstance(project.get("reason", ""), str) or not project.get("reason", ""):
        errors.append("%s: reason is required" % tag)
    added_on = project.get("added_on", "")
    if added_on and (not isinstance(added_on, str) or not DATE_RE.match(added_on)):
        errors.append("%s: added_on must be YYYY-MM-DD" % tag)
    declared = spdx_ids(spdx) if isinstance(spdx, str) else set()
    projdir = os.path.join(root, "projects", language, name)
    if mode == "public" and storage != "copied":
        errors.append("%s: public repo holds copied entries only" % tag)
    if storage == "pinned":
        if mode == "public":
            pass
        if os.path.isdir(projdir) and list_project_files(projdir):
            errors.append("%s: pinned entry must have no files under projects/%s/%s" %
                          (tag, language, name))
        if "NOASSERTION" not in declared and not declared:
            errors.append("%s: pinned entry needs a recorded spdx" % tag)
        paths = project.get("paths", [])
        if (not isinstance(paths, list) or not paths
                or not all(isinstance(p, str) and p for p in paths)):
            errors.append("%s: pinned entry needs a non-empty paths subset" % tag)
        tree_hash = project.get("tree_hash", "")
        if (not isinstance(tree_hash, str)
                or not re.fullmatch(r"sha256:[0-9a-f]{64}", tree_hash)):
            errors.append("%s: pinned entry needs tree_hash sha256:<64 hex>" % tag)
        return 0
    if not os.path.isdir(projdir):
        errors.append("%s: copied entry is missing projects/%s/%s" % (tag, language, name))
        return 0
    if mode == "private" and public_spdx_ok(spdx):
        errors.append("%s: spdx %s is public-allowlisted; it belongs in the public repo" %
                      (tag, spdx))
    if mode == "public" and not public_spdx_ok(spdx):
        errors.append("%s: spdx %s is not on the public allowlist (MIT, Apache-2.0)" %
                      (tag, spdx))
    if not os.path.isfile(os.path.join(projdir, "UPSTREAM.md")):
        errors.append("%s: UPSTREAM.md is required" % tag)
    notice_flag = project.get("notice_present_upstream", False)
    notice_present = any(os.path.isfile(os.path.join(projdir, n)) for n in NOTICE_NAMES)
    if notice_flag and not notice_present:
        errors.append("%s: notice_present_upstream is true but no NOTICE file is present" % tag)
    total = check_project_files(projdir, language, errors, tag)
    sources = 0
    for rel, full in list_project_files(projdir):
        if extension_ok(language, rel) and os.path.isfile(full) and not os.path.islink(full):
            sources += 1
    if sources == 0:
        errors.append("%s: copied entry has no source files for %s" % (tag, language))
    if total > MAX_PROJECT_BYTES:
        errors.append("%s: project is %d bytes, above the %d cap" %
                      (tag, total, MAX_PROJECT_BYTES))
    check_nested_licenses(projdir, errors, tag)
    check_license_files(projdir, declared, mode == "public", errors, tag)
    check_headers(projdir, language, declared, mode == "public", errors, tag)
    recorded = project.get("tree_hash", "")
    actual = compute_tree_hash(projdir)
    if recorded != actual:
        errors.append("%s: tree_hash mismatch: manifest %s, computed %s" %
                      (tag, recorded or "<empty>", actual))
    return total


def check_unowned_tree(root, projects, errors):
    owned = set()
    for project in projects:
        if not isinstance(project, dict):
            continue
        if project.get("storage") == "copied" and project.get("language") in EXTENSIONS:
            name = project.get("name")
            if isinstance(name, str) and NAME_RE.match(name):
                owned.add((project["language"], name))
    top = os.path.join(root, "projects")
    if not os.path.isdir(top):
        return
    for lang in sorted(os.listdir(top)):
        langdir = os.path.join(top, lang)
        if not os.path.isdir(langdir) or os.path.islink(langdir):
            errors.append("projects/%s is not a project directory" % lang)
            continue
        if lang not in EXTENSIONS:
            errors.append("projects/%s is not a known language" % lang)
            continue
        for name in sorted(os.listdir(langdir)):
            full = os.path.join(langdir, name)
            if (lang, name) in owned and os.path.isdir(full) and not os.path.islink(full):
                continue
            errors.append("projects/%s/%s is not owned by a copied manifest entry" % (lang, name))


def cmd_verify(args):
    root = os.path.abspath(args.root)
    data, problems = load_manifest(root, args.manifest)
    errors = list(problems)
    sizes = {}
    if data is not None:
        if data.get("schema_version") != SCHEMA_VERSION:
            errors.append("schema_version must be %d" % SCHEMA_VERSION)
        mode = manifest_mode(data)
        if mode not in ("public", "private"):
            errors.append("[corpus] mode must be public or private")
        elif getattr(args, "expect_mode", None) and mode != args.expect_mode:
            errors.append("manifest mode is %s, expected %s" % (mode, args.expect_mode))
            for item in errors:
                fail(item)
            sys.stdout.write("verify: %d failure(s)\n" % len(errors))
            return 1
        else:
            projects = data.get("project", [])
            if not isinstance(projects, list):
                errors.append("project entries must be a list")
                projects = []
            seen = set()
            for project in projects:
                if not isinstance(project, dict):
                    errors.append("project entry must be a table")
                    continue
                pname = project.get("name", "?")
                if pname in seen:
                    errors.append("project %s: duplicate name" % pname)
                    continue
                seen.add(pname)
                total = verify_project(root, project, mode, errors)
                lang = project.get("language")
                if isinstance(lang, str):
                    sizes[lang] = sizes.get(lang, 0) + total
            check_unowned_tree(root, projects, errors)
            for lang, total in sorted(sizes.items()):
                if total > MAX_LANG_BYTES:
                    errors.append("language %s: %d bytes, above the %d cap" %
                                  (lang, total, MAX_LANG_BYTES))
    if errors:
        for item in errors:
            fail(item)
        sys.stdout.write("verify: %d failure(s)\n" % len(errors))
        return 1
    if args.reuse:
        binary = shutil.which("reuse")
        if binary is None:
            sys.stdout.write("WARN reuse binary not found; skipping REUSE check\n")
        else:
            proc = subprocess.run([binary, "lint"], cwd=root, capture_output=True,
                                  text=True, timeout=300)
            sys.stdout.write(proc.stdout)
            if proc.returncode != 0:
                fail("reuse lint reported problems")
                sys.stdout.write("verify: 1 failure(s)\n")
                return 1
    count = len(data.get("project", [])) if isinstance(data, dict) else 0
    sys.stdout.write("PASS verify: %d project(s), mode %s\n" %
                     (count, manifest_mode(data) if isinstance(data, dict) else "?"))
    return 0


def _glob_to_regex(pattern):
    out = []
    i = 0
    while i < len(pattern):
        char = pattern[i]
        if char == "\\" and i + 1 < len(pattern):
            out.append(re.escape(pattern[i + 1]))
        elif char == "*":
            run = 0
            while i + run < len(pattern) and pattern[i + run] == "*":
                run += 1
            if run >= 2 and i + run < len(pattern) and pattern[i + run] == "/":
                out.append("(?:.*/)?")
                i += run + 1
            elif run >= 2:
                out.append(".*")
                i += run
            else:
                out.append("[^/]*")
                i += 1

def check_subset(patterns):
    for pattern in patterns:
        while pattern.startswith("./"):
            pattern = pattern[2:]
        try:
            re.compile(_glob_to_regex(pattern))
        except re.error as exc:
            return "bad path pattern %r: %s" % (pattern, exc)
    return None


def match_subset(relpath, patterns):
    for pattern in patterns:
        while pattern.startswith("./"):
            pattern = pattern[2:]
        if relpath == pattern:
            return True
        if re.fullmatch(_glob_to_regex(pattern), relpath):
            return True
    return False


def _toml_basic(value):
    out = []
    for char in value:
        code = ord(char)
        if char == "\\":
            out.append("\\\\")
        elif char == '"':
            out.append('\\"')
        elif char == "\b":
            out.append("\\b")
        elif char == "\t":
            out.append("\\t")
        elif char == "\n":
            out.append("\\n")
        elif char == "\f":
            out.append("\\f")
        elif char == "\r":
            out.append("\\r")
        elif code < 0x20 or code == 0x7F:
            out.append("\\u%04X" % code)
        else:
            out.append(char)
    return "".join(out)


def record_entry(root, args, url, patterns, excludes, storage, tree_hash, stamp, notice_flag):
    quote = lambda value: '"%s"' % _toml_basic(value)
    entry = ("\n[[project]]\n"
             "name = %s\n"
             "language = %s\n"
             "url = %s\n"
             "rev = %s\n"
             "spdx = %s\n"
             "storage = %s\n"
             "paths = [%s]\n" % (
                 quote(args.name), quote(args.lang), quote(url), quote(args.rev),
                 quote(args.spdx), quote(storage),
                 ", ".join(quote(p) for p in patterns)))
    if excludes:
        entry += "exclude = [%s]\n" % ", ".join(quote(p) for p in excludes)
    entry += ("tree_hash = %s\n"
              "added_by = %s\n"
              "added_on = %s\n"
              "reason = %s\n"
              "notice_present_upstream = %s\n" % (
                  quote(tree_hash), quote(args.added_by or "unknown"), quote(stamp),
                  quote(args.reason), "true" if notice_flag else "false"))
    manifest_path = find_manifest(root, args.manifest)
    with open(manifest_path, "r", encoding="utf-8") as fh:
        current = fh.read()
    try:
        tomllib.loads(current + entry)
    except Exception as exc:
        fail("refusing to write an unparsable manifest entry: %s" % exc)
        return 1
    with open(manifest_path, "a", encoding="utf-8") as fh:
        fh.write(entry)
    verify_args = argparse.Namespace(root=root, manifest=args.manifest, reuse=False,
                                    expect_mode=None)
    if cmd_verify(verify_args) != 0:
        fail("added tree does not pass verify; entry kept for inspection")
        return 1
    if storage == "pinned":
        sys.stdout.write("PASS add: pinned %s\n" % args.name)
    else:
        sys.stdout.write("PASS add: projects/%s/%s\n" % (args.lang, args.name))
    return 0


def license_like(name):
    return (LICENSE_LIKE_RE.fullmatch(name) is not None
            and os.path.splitext(name)[1] not in SOURCE_SUFFIXES)


def differing_license_file(scopedir, root_texts):
    for base in sorted(os.listdir(scopedir)):
        candidate = os.path.join(scopedir, base)
        if not license_like(base):
            continue
        if os.path.islink(candidate):
            return base
        if not os.path.isfile(candidate):
            continue
        with open(candidate, "rb") as fh:
            if fh.read() not in root_texts:
                return base
    return None


def check_upstream_nesting(cache, selected, root_texts, errors, tag):
    verdicts = {}
    for rel, full in selected:
        if os.path.islink(full):
            continue
        scopes = rel.split("/")[:-1]
        for depth in range(1, len(scopes) + 1):
            scope = "/".join(scopes[:depth])
            if scope not in verdicts:
                verdicts[scope] = differing_license_file(os.path.join(cache, scope), root_texts)
            if verdicts[scope] is not None:
                errors.append("%s: %s is governed by nested %s/%s, which differs "
                              "from the project license; vendored third-party code "
                              "is excluded" % (tag, rel, scope, verdicts[scope]))
                return


def cmd_add(args):
    root = os.path.abspath(args.root)
    data, problems = load_manifest(root, args.manifest)
    if data is None:
        for item in problems:
            fail(item)
        return 1
    mode = manifest_mode(data)
    storage = args.storage or ("pinned" if "NOASSERTION" in spdx_ids(args.spdx) else "copied")
    if mode == "public" and storage != "copied":
        fail("public repo holds copied entries only")
        return 1
    if not NAME_RE.match(args.name):
        fail("bad name; use [a-z0-9-]")
        return 1
    if not _spdx_wellformed(args.spdx):
        fail("spdx %r is not a well-formed expression" % args.spdx)
        return 1
    existing = set()
    for entry in data.get("project", []):
        if isinstance(entry, dict) and isinstance(entry.get("name"), str):
            existing.add(entry["name"])
    if args.name in existing:
        fail("project %s already exists in the manifest" % args.name)
        return 1
    if args.lang not in EXTENSIONS:
        fail("unknown language %s" % args.lang)
        return 1
    if not REV_RE.match(args.rev):
        fail("rev must be a 40-hex commit, never a branch or tag")
        return 1
    url = args.url
    if url.startswith("https://") or url.startswith("file://"):
        pass
    elif os.path.isdir(url):
        url = pathlib.Path(url).resolve().as_uri()
    else:
        fail("url must start with https:// or file://, or be a local directory")
        return 1
    if mode == "private" and public_spdx_ok(args.spdx):
        fail("spdx %s is public-allowlisted; it belongs in the public repo" % args.spdx)
        return 1
    if mode == "public" and not public_spdx_ok(args.spdx):
        fail("spdx %s is not on the public allowlist" % args.spdx)
        return 1
    scratch_parent = os.path.join(root, ".cache", "tmp")
    os.makedirs(scratch_parent, exist_ok=True)
    patterns = [p.strip() for p in args.paths.split(",") if p.strip()]
    excludes = [p.strip() for p in (args.exclude or "").split(",") if p.strip()]
    problem = check_subset(patterns + excludes)
    if problem is not None:
        fail(problem)
        return 1
    cache = tempfile.mkdtemp(prefix="add-" + args.name + "-", dir=scratch_parent)
    proc = subprocess.run(["git", "clone", "--quiet", url, cache],
                          capture_output=True, text=True, timeout=600)
    if proc.returncode != 0:
        shutil.rmtree(cache, ignore_errors=True)
        fail("git clone failed: %s" % (proc.stderr.strip().splitlines() or ["unknown"])[0])
        return 1
    proc = subprocess.run(["git", "-C", cache, "checkout", "--quiet", args.rev],
                          capture_output=True, text=True, timeout=300)
    if proc.returncode != 0:
        shutil.rmtree(cache, ignore_errors=True)
        fail("rev %s not found upstream" % args.rev)
        return 1
    if storage == "copied":
        for base in LICENSE_NAMES + NOTICE_NAMES:
            candidate = os.path.join(cache, base)
            if os.path.islink(candidate):
                shutil.rmtree(cache, ignore_errors=True)
                fail("upstream %s is a symlink; refusing to copy linked license text"
                     % base)
                return 1
    selected = []
    for dirpath, dirnames, filenames in os.walk(cache):
        if ".git" in dirnames:
            dirnames.remove(".git")
        dirnames.sort()
        for name in sorted(filenames):
            full = os.path.join(dirpath, name)
            rel = os.path.relpath(full, cache).replace(os.sep, "/")
            if match_subset(rel, patterns) and not match_subset(rel, excludes):
                selected.append((rel, full))
    if not selected:
        shutil.rmtree(cache, ignore_errors=True)
        fail("path subset selected no files")
        return 1
    projdir = os.path.join(root, "projects", args.lang, args.name)
    if os.path.exists(projdir):
        shutil.rmtree(cache, ignore_errors=True)
        fail("projects/%s/%s already exists" % (args.lang, args.name))
        return 1
    stamp = time.strftime("%Y-%m-%d")
    if storage == "pinned":
        staged = tempfile.mkdtemp(prefix="stage-" + args.name + "-",
                                  dir=scratch_parent)
        for rel, full in selected:
            if os.path.islink(full):
                continue
            dest = os.path.join(staged, rel)
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            shutil.copyfile(full, dest)
        tree_hash = compute_tree_hash(staged)
        shutil.rmtree(staged, ignore_errors=True)
        shutil.rmtree(cache, ignore_errors=True)
        return record_entry(root, args, url, patterns, excludes, storage,
                            tree_hash, stamp, False)
    os.makedirs(projdir)
    copied = []
    for rel, full in selected:
        if os.path.islink(full):
            continue
        base = os.path.basename(rel)
        if base in LICENSE_NAMES + NOTICE_NAMES and rel.count("/") > 0:
            continue
        if base == ".gitmodules" or rel.endswith("/.gitmodules"):
            continue
        if not extension_ok(args.lang, rel):
            continue
        dest = os.path.join(projdir, rel)
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        shutil.copyfile(full, dest)
        copied.append((rel, full))
    if not copied:
        shutil.rmtree(cache, ignore_errors=True)
        shutil.rmtree(projdir, ignore_errors=True)
        fail("path subset copied no source files for %s; refusing empty entry" %
             args.lang)
        return 1
    license_srcs = []
    for base in LICENSE_NAMES:
        candidate = os.path.join(cache, base)
        if os.path.isfile(candidate):
            license_srcs.append(candidate)
    if not license_srcs and storage == "copied":
        shutil.rmtree(cache, ignore_errors=True)
        shutil.rmtree(projdir, ignore_errors=True)
        fail("upstream has no LICENSE or COPYING file")
        return 1
    for license_src in license_srcs:
        shutil.copyfile(license_src, os.path.join(projdir, os.path.basename(license_src)))
    notice_src = None
    for base in NOTICE_NAMES:
        candidate = os.path.join(cache, base)
        if os.path.isfile(candidate):
            notice_src = candidate
            break
    notice_flag = bool(notice_src)
    if notice_src is not None:
        shutil.copyfile(notice_src, os.path.join(projdir, os.path.basename(notice_src)))
    root_texts = []
    for path in license_srcs + [notice_src]:
        if path is not None:
            with open(path, "rb") as fh:
                root_texts.append(fh.read())
    nesting_errors = []
    check_upstream_nesting(cache, copied, root_texts, nesting_errors,
                           "project %s" % args.name)
    if nesting_errors:
        shutil.rmtree(cache, ignore_errors=True)
        shutil.rmtree(projdir, ignore_errors=True)
        for item in nesting_errors:
            fail(item)
        return 1
    with open(os.path.join(projdir, "UPSTREAM.md"), "w", encoding="utf-8") as fh:
        fh.write("# Upstream provenance\n\n")
        fh.write("url: %s\n" % url)
        fh.write("rev: %s\n" % args.rev)
        fh.write("retrieved: %s\n" % stamp)
        fh.write("spdx: %s\n" % args.spdx)
        fh.write("subset: %s\n" % ", ".join(patterns))
        fh.write("added_by: %s\n" % (args.added_by or "unknown"))
        fh.write("reason: %s\n" % args.reason)
        fh.write("modifications: unmodified subset copy\n")
    tree_hash = compute_tree_hash(projdir)
    shutil.rmtree(cache, ignore_errors=True)
    return record_entry(root, args, url, patterns, excludes, storage,
                        tree_hash, stamp, notice_flag)


def cached_pinned_dir(root, language, name):
    return os.path.join(root, ".cache", "tree", language, name)


def cmd_fetch(args):
    root = os.path.abspath(args.root)
    data, problems = load_manifest(root, args.manifest)
    if data is None:
        for item in problems:
            fail(item)
        return 1
    projects = data.get("project", [])
    if args.lang:
        projects = [p for p in projects if p.get("language") == args.lang]
    failures = 0
    cache_base = os.path.abspath(os.path.join(root, ".cache", "tree"))
    for project in projects:
        name = project.get("name", "?")
        language = project.get("language", "")
        storage = project.get("storage", "")
        tag = "project %s" % name
        if not isinstance(name, str) or not NAME_RE.match(name):
            fail("%s: bad name; use [a-z0-9-]" % tag)
            failures += 1
            continue
        if language not in EXTENSIONS:
            fail("%s: unknown language %r" % (tag, language))
            failures += 1
            continue
        if storage == "copied":
            if not args.check:
                continue
            projdir = os.path.join(root, "projects", language, name)
            if not os.path.isdir(projdir):
                fail("%s: copied entry missing from tree" % tag)
                failures += 1
                continue
            if compute_tree_hash(projdir) != project.get("tree_hash", ""):
                fail("%s: tree_hash mismatch" % tag)
                failures += 1
                continue
            sys.stdout.write("PASS fetch --check %s\n" % tag)
        else:
            declared = spdx_ids(project.get("spdx", ""))
            custom = sorted(item for item in declared
                            if item.lower().startswith(("licenseref-", "documentref-"))
                            or ":" in item)
            if (("NOASSERTION" in declared or not declared) and not args.allow_unlicensed
                    and not args.check):
                fail("%s: pinned entry has no license; refusing (owner decision c default); "
                     "re-run with --allow-unlicensed for a logged local copy" % tag)
                failures += 1
                continue
            if custom and not args.allow_unlicensed and not args.check:
                fail("%s: pinned entry declares custom license %s; refusing without "
                     "explicit consent; re-run with --allow-unlicensed for a logged "
                     "local copy" % (tag, custom[0]))
                failures += 1
                continue
            dest = cached_pinned_dir(root, language, name)
            if os.path.normpath(dest) != dest or not dest.startswith(cache_base + os.sep):
                fail("%s: pinned cache path escapes .cache/tree; refusing" % tag)
                failures += 1
                continue
            if args.check:
                if not os.path.isdir(dest):
                    fail("%s: pinned entry not materialized under .cache/tree" % tag)
                    failures += 1
                    continue
                if compute_tree_hash(dest) != project.get("tree_hash", ""):
                    fail("%s: cached tree_hash mismatch" % tag)
                    failures += 1
                    continue
                sys.stdout.write("PASS fetch --check %s\n" % tag)
                continue
            stored = project.get("paths", [])
            stored_excludes = project.get("exclude", [])
            if (not isinstance(stored, list) or not stored
                    or not all(isinstance(item, str) for item in stored)):
                fail("%s: pinned entry needs a non-empty paths subset" % tag)
                failures += 1
                continue
            if (not isinstance(stored_excludes, list)
                    or not all(isinstance(item, str) for item in stored_excludes)):
                fail("%s: pinned entry needs exclude as a list of strings" % tag)
                failures += 1
                continue
            problem = check_subset(stored + stored_excludes)
            if problem is not None:
                fail("%s: %s" % (tag, problem))
                failures += 1
                continue
            scratch_parent = os.path.join(root, ".cache", "tmp")
            os.makedirs(scratch_parent, exist_ok=True)
            tmp = tempfile.mkdtemp(prefix="fetch-" + name + "-", dir=scratch_parent)
            proc = subprocess.run(["git", "clone", "--quiet", project["url"], tmp],
                                  capture_output=True, text=True, timeout=600)
            if proc.returncode != 0:
                shutil.rmtree(tmp, ignore_errors=True)
                fail("%s: git clone failed" % tag)
                failures += 1
                continue
            proc = subprocess.run(["git", "-C", tmp, "checkout", "--quiet", project["rev"]],
                                  capture_output=True, text=True, timeout=300)
            if proc.returncode != 0:
                fail("%s: rev %s unresolvable upstream" % (tag, project.get("rev")))
                shutil.rmtree(tmp, ignore_errors=True)
                failures += 1
                continue
            patterns = project.get("paths", [])
            excludes = project.get("exclude", [])
            if os.path.isdir(dest):
                shutil.rmtree(dest)
            os.makedirs(dest)
            for dirpath, dirnames, filenames in os.walk(tmp):
                if ".git" in dirnames:
                    dirnames.remove(".git")
                dirnames.sort()
                for fname in sorted(filenames):
                    full = os.path.join(dirpath, fname)
                    rel = os.path.relpath(full, tmp).replace(os.sep, "/")
                    if match_subset(rel, patterns) and not match_subset(rel, excludes):
                        if os.path.islink(full):
                            continue
                        out = os.path.join(dest, rel)
                        os.makedirs(os.path.dirname(out), exist_ok=True)
                        shutil.copyfile(full, out)
            shutil.rmtree(tmp, ignore_errors=True)
            if compute_tree_hash(dest) != project.get("tree_hash", ""):
                fail("%s: materialized tree_hash mismatch" % tag)
                failures += 1
                continue
            sys.stdout.write("PASS fetch %s\n" % tag)
    if failures:
        sys.stdout.write("fetch: %d failure(s)\n" % failures)
        return 1
    sys.stdout.write("PASS fetch\n")
    return 0


def find_sloplint(explicit=None):
    for candidate in (explicit, os.environ.get("CORPUS_SLOPLINT")):
        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return shutil.which("sloplint")


def cmd_measure(args):
    root = os.path.abspath(args.root)
    data, problems = load_manifest(root, args.manifest)
    if data is None:
        for item in problems:
            fail(item)
        return 1
    language = args.lang
    if language not in EXTENSIONS:
        fail("unknown language %s" % language)
        return 1
    projects = [p for p in data.get("project", [])
                if p.get("language") == language and p.get("storage") == "copied"]
    missing = [p.get("name", "?") for p in projects
               if not os.path.isdir(os.path.join(root, "projects", language,
                                                 p.get("name", "")))]
    if missing:
        for name in sorted(missing):
            fail("project %s: copied entry is missing projects/%s/%s" %
                 (name, language, name))
        return 1
    binary = find_sloplint(args.sloplint)
    if binary is None:
        fail("sloplint binary not found (PATH or CORPUS_SLOPLINT); refusing")
        return 1
    try:
        version = subprocess.run([binary, "--version"], capture_output=True,
                                 text=True, timeout=60).stdout.strip()
    except Exception:
        version = "unknown"
    try:
        corpus_rev = subprocess.run(["git", "-C", root, "rev-parse", "HEAD"],
                                    capture_output=True, text=True,
                                    timeout=60).stdout.strip() or "uncommitted"
    except Exception:
        corpus_rev = "uncommitted"
    files_all = []
    total_bytes = 0
    for project in sorted(projects, key=lambda p: p.get("name", "")):
        projdir = os.path.join(root, "projects", language, project["name"])
        for rel, full in list_project_files(projdir):
            if extension_ok(language, rel) and os.path.isfile(full) and not os.path.islink(full):
                files_all.append(full)
                total_bytes += os.path.getsize(full)
    files_all.sort()
    findings = []
    rules_fired = {}
    parse_error_files = set()
    panics = 0
    wall_ms = 0
    for project in sorted(projects, key=lambda p: p.get("name", "")):
        projdir = os.path.join(root, "projects", language, project["name"])
        start = time.monotonic()
        try:
            proc = subprocess.run(
                [binary, "check", "--root", projdir, "--format", "json",
                 "--strictness", "standard", "--mode", "threshold",
                 "--fail-on", "never", "--no-cache"],
                capture_output=True, text=True, timeout=1200)
        except Exception as exc:
            fail("sloplint error on %s: %s" % (project["name"], exc))
            return 1
        wall_ms += int((time.monotonic() - start) * 1000)
        if proc.returncode == 3 or "panicked" in proc.stderr.lower():
            panics += 1
        try:
            doc = json.loads(proc.stdout)
        except Exception:
            fail("sloplint output for %s is not JSON" % project["name"])
            panics += 1
            continue
        for item in doc.get("findings", []):
            raw_path = item.get("path", "")
            pname = project.get("name", "?")
            item["path"] = "%s/%s" % (pname, raw_path) if raw_path else pname
            findings.append(item)
            if item.get("rule") == "meta/parse-error":
                parse_error_files.add(item["path"])
        for key, value in doc.get("rules", {}).items():
            rules_fired[key] = value
    findings.sort(key=lambda f: (str(f.get("path", "")), int(f.get("line", 0)),
                                 int(f.get("column", 0)), str(f.get("rule", ""))))
    per_rule = {}
    for item in findings:
        rule = str(item.get("rule", "unknown"))
        per_rule[rule] = per_rule.get(rule, 0) + 1
    rng = random.Random(0xC0FFEE)
    pool = list(findings)
    rng.shuffle(pool)
    samples = [{"rule": str(f.get("rule", "")), "file": str(f.get("path", "")),
                "line": int(f.get("line", 0)), "verdict": "unreviewed"}
               for f in pool[:20]]
    samples.sort(key=lambda s: (s["rule"], s["file"], s["line"]))
    file_count = len(files_all)
    kb = total_bytes / 1024.0
    report = {
        "language": language,
        "corpus_rev": corpus_rev,
        "sloplint_version": version,
        "projects": sorted(p.get("name", "") for p in projects),
        "files": file_count,
        "bytes": total_bytes,
        "parse_errors": sum(1 for f in findings if f.get("rule") == "meta/parse-error"),
        "parse_error_files": sorted(parse_error_files),
        "parse_error_rate_per_file": (sum(1 for f in findings if f.get("rule") == "meta/parse-error") / file_count) if file_count else 0.0,
        "parse_error_rate_per_kb": (sum(1 for f in findings if f.get("rule") == "meta/parse-error") / kb) if kb else 0.0,
        "panics": panics,
        "wall_ms": wall_ms,
        "wall_ms_per_mb": (wall_ms / (total_bytes / (1024.0 * 1024.0))) if total_bytes else 0.0,
        "findings_per_rule": dict(sorted(per_rule.items())),
        "fp_samples": samples,
    }
    out = args.out or os.path.join(root, "reports", language + ".json")
    os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
    with open(out, "w", encoding="utf-8") as fh:
        json.dump(report, fh, indent=2, sort_keys=True)
        fh.write("\n")
    budgets_path = args.against or os.path.join(root, "budgets.toml")
    failures = []
    if panics > 0:
        failures.append("panics = %d, budget is zero" % panics)
    if os.path.isfile(budgets_path):
        with open(budgets_path, "rb") as fh:
            budgets = tomllib.load(fh)
        table = budgets.get(language, {})
        min_projects = int(table.get("min_projects", 3))
        if len(projects) < min_projects:
            sys.stdout.write("WARN %s has %d of %d projects; budget check warns only\n" %
                             (language, len(projects), min_projects))
        elif table:
            for key, actual in (
                    ("max_parse_error_per_file", report["parse_error_rate_per_file"]),
                    ("max_parse_error_per_kb", report["parse_error_rate_per_kb"]),
                    ("max_wall_ms_per_mb", report["wall_ms_per_mb"])):
                limit = table.get(key)
                if limit is not None and actual > limit:
                    failures.append("%s: %.6g above budget %.6g" % (key, actual, limit))
            if table.get("max_panics", 0) is not None and panics > int(table.get("max_panics", 0)):
                failures.append("panics = %d above budget" % panics)
    else:
        sys.stdout.write("WARN no budgets file at %s\n" % budgets_path)
    sys.stdout.write("measure: %s files=%d bytes=%d parse_errors=%d panics=%d wall_ms=%d\n" %
                     (language, file_count, total_bytes, report["parse_errors"], panics, wall_ms))
    if failures:
        for item in failures:
            fail(item)
        return 1
    sys.stdout.write("PASS measure %s -> %s\n" % (language, out))
    return 0


def seed_name(pname, rel):
    pathhash = hashlib.sha256(("%s/%s" % (pname, rel)).encode(
        "utf-8", "surrogateescape")).hexdigest()[:16]
    stem = "%s__%s" % (pname, os.path.basename(rel))
    suffix = "__" + pathhash
    if len((stem + suffix).encode("utf-8", "surrogateescape")) > 200:
        budget = 200 - len(suffix.encode("utf-8", "surrogateescape"))
        stem = stem.encode("utf-8", "surrogateescape")[:budget].decode("utf-8", "ignore")
    return "%s__%s" % (stem, pathhash)


def cmd_seeds(args):
    root = os.path.abspath(args.root)
    data, problems = load_manifest(root, args.manifest)
    if data is None:
        for item in problems:
            fail(item)
        return 1
    language = args.lang
    if language not in EXTENSIONS:
        fail("unknown language %s" % language)
        return 1
    projects = [p for p in data.get("project", [])
                if p.get("language") == language and p.get("storage") == "copied"]
    report_path = os.path.join(root, "reports", language + ".json")
    priority = set()
    if os.path.isfile(report_path):
        try:
            with open(report_path, encoding="utf-8") as fh:
                priority = set(json.load(fh).get("parse_error_files", []))
        except Exception:
            pass
    def order(item):
        rel, full, pname, size, digest = item
        short = "%s/%s" % (pname, rel)
        return (0 if short in priority else 1, size, short)

    candidates = []
    for project in sorted(projects, key=lambda p: p.get("name", "")):
        projdir = os.path.join(root, "projects", language, project["name"])
        for rel, full in list_project_files(projdir):
            if not extension_ok(language, rel):
                continue
            if os.path.islink(full) or not os.path.isfile(full):
                continue
            size = os.path.getsize(full)
            if size > MAX_FILE_BYTES or size == 0:
                continue
            with open(full, "rb") as fh:
                digest = hashlib.sha256(fh.read()).hexdigest()
            candidates.append((rel, full, project["name"], size, digest))
    candidates.sort(key=order)
    seen = set()
    unique = []
    for item in candidates:
        if item[4] in seen:
            continue
        seen.add(item[4])
        unique.append(item)
    out = os.path.abspath(args.out)
    os.makedirs(out, exist_ok=True)
    ledger = out + ".corpus-seeds." + language + ".json"
    have_ledger = os.path.isfile(ledger)
    try:
        with open(ledger, "a", encoding="utf-8"):
            pass
    except OSError as exc:
        fail("seeds %s: cannot write ledger %s: %s" % (language, ledger, exc))
        return 1
    used = 0
    written = 0
    planned = {}
    for rel, full, pname, size, digest in unique:
        if used + size > args.max_bytes:
            continue
        planned[seed_name(pname, rel)] = (full, size)
        used += size
    previous = []
    if have_ledger:
        try:
            with open(ledger, encoding="utf-8") as fh:
                previous = json.load(fh)
        except Exception:
            previous = []
    else:
        legacy = os.path.join(out, ".corpus-seeds." + language + ".json")
        if os.path.isfile(legacy):
            try:
                with open(legacy, encoding="utf-8") as fh:
                    previous = json.load(fh)
            except Exception:
                previous = []
    if isinstance(previous, list):
        for stale in previous:
            if stale in planned or os.path.basename(stale) != stale:
                continue
            victim = os.path.join(out, stale)
            if os.path.isfile(victim) and not os.path.islink(victim):
                os.remove(victim)
    for flat in sorted(planned):
        full, size = planned[flat]
        with open(full, "rb") as src:
            content = src.read()
        with open(os.path.join(out, flat), "wb") as dst:
            dst.write(content)
        written += 1
    for name in sorted(os.listdir(out)):
        if name.startswith(".corpus-seeds.") and name.endswith(".json"):
            victim = os.path.join(out, name)
            if os.path.isfile(victim) and not os.path.islink(victim):
                os.remove(victim)
    with open(ledger, "w", encoding="utf-8") as fh:
        json.dump(sorted(planned), fh)
        fh.write("\n")
    sys.stdout.write("PASS seeds %s: %d files, %d bytes -> %s\n" % (language, written, used, out))
    return 0


def cmd_stats(args):
    root = os.path.abspath(args.root)
    data, problems = load_manifest(root, args.manifest)
    if data is None:
        for item in problems:
            fail(item)
        return 1
    totals = {}
    for project in data.get("project", []):
        language = project.get("language", "?")
        row = totals.setdefault(language, {"projects": 0, "copied": 0, "pinned": 0,
                                           "files": 0, "bytes": 0})
        row["projects"] += 1
        storage = project.get("storage", "")
        if storage == "copied":
            row["copied"] += 1
            projdir = os.path.join(root, "projects", language, project.get("name", ""))
            for rel, full in list_project_files(projdir):
                if extension_ok(language, rel) and os.path.isfile(full) and not os.path.islink(full):
                    row["files"] += 1
                    row["bytes"] += os.path.getsize(full)
        else:
            row["pinned"] += 1
    if args.format == "json":
        sys.stdout.write(json.dumps(totals, indent=2, sort_keys=True) + "\n")
    else:
        for language in sorted(totals):
            row = totals[language]
            sys.stdout.write("%-12s projects=%d copied=%d pinned=%d files=%d bytes=%d\n" %
                             (language, row["projects"], row["copied"], row["pinned"],
                              row["files"], row["bytes"]))
    return 0


def build_parser():
    parser = argparse.ArgumentParser(prog="corpus",
                                     description="Shared tooling for the sloplint corpus repos.")
    sub = parser.add_subparsers(dest="command", required=True)
    verify = sub.add_parser("verify", help="Fail-closed license and content gate.")
    verify.add_argument("--root", default=".")
    verify.add_argument("--manifest", default=None)
    verify.add_argument("--offline", action="store_true",
                        help="Skip reachability checks (default; verify never uses the network).")
    verify.add_argument("--reuse", action="store_true",
                        help="Also run reuse lint on the repo root when the binary is present.")
    verify.add_argument("--expect-mode", default=None, choices=("public", "private"),
                        help="Fail when the manifest mode differs; the gate supplies this.")
    add = sub.add_parser("add", help="Record a project: fetch at a pinned rev, gate, copy.")
    add.add_argument("--root", default=".")
    add.add_argument("--manifest", default=None)
    add.add_argument("--url", required=True)
    add.add_argument("--rev", required=True, help="Full 40-hex commit.")
    add.add_argument("--lang", required=True, help="Language key, for example rust.")
    add.add_argument("--spdx", required=True, help="SPDX id or OR expression.")
    add.add_argument("--name", required=True, help="Project slug [a-z0-9-].")
    add.add_argument("--paths", required=True, help="Comma separated subset globs.")
    add.add_argument("--exclude", default="")
    add.add_argument("--reason", required=True)
    add.add_argument("--storage", choices=("copied", "pinned"), default=None)
    add.add_argument("--added-by", default="")
    fetch = sub.add_parser("fetch", help="Materialize pinned entries; --check verifies hashes.")
    fetch.add_argument("--root", default=".")
    fetch.add_argument("--manifest", default=None)
    fetch.add_argument("--lang", default=None)
    fetch.add_argument("--check", action="store_true")
    fetch.add_argument("--allow-unlicensed", action="store_true",
                       help="Allow a logged local copy of NOASSERTION entries.")
    measure = sub.add_parser("measure", help="Run sloplint on a language and aggregate JSON.")
    measure.add_argument("lang")
    measure.add_argument("--root", default=".")
    measure.add_argument("--manifest", default=None)
    measure.add_argument("--against", default=None)
    measure.add_argument("--out", default=None)
    measure.add_argument("--sloplint", default=None)
    seeds = sub.add_parser("seeds", help="Extract deterministic fuzz seed material.")
    seeds.add_argument("lang")
    seeds.add_argument("--root", default=".")
    seeds.add_argument("--manifest", default=None)
    seeds.add_argument("--out", required=True)
    seeds.add_argument("--max-bytes", type=int, default=1048576)
    stats = sub.add_parser("stats", help="Per-language project, file and byte totals.")
    stats.add_argument("--root", default=".")
    stats.add_argument("--manifest", default=None)
    stats.add_argument("--format", choices=("text", "json"), default="text")
    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command == "verify":
        return cmd_verify(args)
    if args.command == "add":
        return cmd_add(args)
    if args.command == "fetch":
        return cmd_fetch(args)
    if args.command == "measure":
        return cmd_measure(args)
    if args.command == "seeds":
        return cmd_seeds(args)
    if args.command == "stats":
        return cmd_stats(args)
    parser.print_help()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
